# PostgreSQL Database
DB_URL=jdbc:postgresql://localhost:5434/e-commerce
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# JWT Secret & Expiration
# Generate a Base64-encoded random key of at least 32 bytes. See README.
JWT_SECRET=replace_with_generated_base64_key
JWT_EXPIRATION=3600000

# Local Maven + Vite with the Compose test mailbox (docker compose up -d mailbox).
# ACCOUNT_PUBLIC_URL=http://localhost:5173
# ACCOUNT_MAIL_ENDPOINT=http://localhost:8025/emails
# ACCOUNT_MAIL_FROM=shop@example.invalid
# RESEND_API_KEY=local-mailbox-only

# VNPay Sandbox merchant credentials. Set both to enable the checkout option.
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
